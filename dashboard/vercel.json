{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:rota*",
      "destination": "/api/ponte?rota=:rota*"
    }
  ],
  "functions": {
    "api/ponte.js": {
      "maxDuration": 15
    }
  }
}
